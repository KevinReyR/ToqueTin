# Supabase public configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Tracking notifications public configuration
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_your_public_vapid_key

# Application origin used only to generate absolute tracking QR URLs.
APP_BASE_URL=http://127.0.0.1:3000

# Server-only secrets. Never prefix these variables with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
TRACKING_TOKEN_HMAC_SECRET=replace_with_a_random_secret_of_at_least_32_characters
VAPID_PRIVATE_KEY=replace_with_your_private_vapid_key

# Edge Function only. Store these values as Supabase secrets in production.
VAPID_SUBJECT=mailto:notifications@example.com
NOTIFICATION_DISPATCH_SECRET=replace_with_a_random_dispatch_secret
